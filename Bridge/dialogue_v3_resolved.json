{"lines": [
{"id": "v01", "t": 0.00, "voice": "zira", "text": "Downtown, please.", "fx": "room", "dur": 2.75},
{"id": "v02", "t": 0.00, "voice": "david", "text": "Right away.", "fx": "room", "dur": 1.80},
{"id": "v03", "t": 0.00, "voice": "zira", "text": "Is it always this quiet?", "fx": "room", "dur": 2.36},
{"id": "v04", "t": 0.00, "voice": "david", "text": "In the morning.", "fx": "room", "dur": 1.87},
{"id": "v05", "t": 0.00, "voice": "hazel", "text": "Every road is real. Every route is yours.", "fx": "room", "dur": 4.25},
{"id": "v06", "t": 0.00, "voice": "zira", "text": "Do you ever stop?", "fx": "room", "dur": 2.10},
{"id": "v07", "t": 0.00, "voice": "david", "text": "Not when it matters.", "fx": "room", "dur": 2.38},
{"id": "v08", "t": 0.00, "voice": "hazel", "text": "All units. Vehicle spotted.", "fx": "radio", "dur": 3.77},
{"id": "v09", "t": 0.00, "voice": "zira", "text": "Are they following us?", "fx": "room", "dur": 2.13},
{"id": "v10", "t": 0.00, "voice": "david", "text": "Don't turn around.", "fx": "room", "dur": 2.28},
{"id": "v11", "t": 0.00, "voice": "hazel", "text": "Do not lose that car.", "fx": "radio", "dur": 2.27},
{"id": "v12", "t": 0.00, "voice": "david", "text": "Hold on tight.", "fx": "room", "dur": 2.11},
{"id": "v13", "t": 0.00, "voice": "zira", "text": "Who are you?", "fx": "room", "dur": 1.61},
{"id": "v14", "t": 0.00, "voice": "david", "text": "Just a driver.", "fx": "room", "dur": 2.10}
]}
