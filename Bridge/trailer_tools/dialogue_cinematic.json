{
    "lines":  [
                  {
                      "id":  "c01",
                      "t":  8.0,
                      "voice":  "zira",
                      "text":  "Downtown, please.",
                      "fx":  "room",
                      "dur":  2.75
                  },
                  {
                      "id":  "c02",
                      "t":  10.5,
                      "voice":  "david",
                      "text":  "Right away.",
                      "fx":  "room",
                      "dur":  1.8
                  },
                  {
                      "id":  "c03",
                      "t":  14.1,
                      "voice":  "zira",
                      "text":  "Is it always this quiet?",
                      "fx":  "room",
                      "dur":  2.36
                  },
                  {
                      "id":  "c04",
                      "t":  16.6,
                      "voice":  "david",
                      "text":  "In the morning.",
                      "fx":  "room",
                      "dur":  1.87
                  },
                  {
                      "id":  "c05",
                      "t":  21.1,
                      "voice":  "zira",
                      "text":  "Do you ever stop?",
                      "fx":  "room",
                      "dur":  2.1
                  },
                  {
                      "id":  "c06",
                      "t":  23.7,
                      "voice":  "david",
                      "text":  "Not when it matters.",
                      "fx":  "room",
                      "dur":  2.38
                  },
                  {
                      "id":  "c07",
                      "t":  29.0,
                      "voice":  "hazel",
                      "text":  "All units. Vehicle spotted.",
                      "fx":  "radio",
                      "dur":  3.77
                  },
                  {
                      "id":  "c08",
                      "t":  31.6,
                      "voice":  "zira",
                      "text":  "Are they following us?",
                      "fx":  "room",
                      "dur":  2.13
                  },
                  {
                      "id":  "c09",
                      "t":  34.9,
                      "voice":  "david",
                      "text":  "Hold on.",
                      "fx":  "room",
                      "dur":  1.84
                  },
                  {
                      "id":  "c10",
                      "t":  37.4,
                      "voice":  "hazel",
                      "text":  "Do not lose that car.",
                      "fx":  "radio",
                      "dur":  2.27
                  },
                  {
                      "id":  "c11",
                      "t":  41.4,
                      "voice":  "david",
                      "text":  "Not tonight.",
                      "fx":  "room",
                      "dur":  1.92
                  },
                  {
                      "id":  "c12",
                      "t":  46.5,
                      "voice":  "zira",
                      "text":  "Who are you?",
                      "fx":  "room",
                      "dur":  1.61
                  },
                  {
                      "id":  "c13",
                      "t":  53.7,
                      "voice":  "david",
                      "text":  "Just a driver.",
                      "fx":  "room",
                      "dur":  2.1
                  },
                  {
                      "id":  "c14",
                      "t":  62.1,
                      "voice":  "hazel",
                      "text":  "We lost him.",
                      "fx":  "radio",
                      "dur":  1.83
                  }
              ]
}
